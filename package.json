    "url": "https://github.com/n7get/node-red-contrib-ax25/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "nodes/connect.js",
  "scripts": {
    "test": "mocha 'test/**/*.test.js' --timeout 5000"
  },
  "devDependencies": {
