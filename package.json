{
  "name": "node-red-contrib-tcpip",
  "version": "0.1.0",
  "description": "Node-RED nodes for managing multiple simultaneous TCP/IP and UDP connections with sessionId-based routing, status updates and structured error envelopes.",
  "keywords": [
    "node-red",
    "tcp",
    "tcpip",
    "udp",
    "socket",
    "networking",
    "multicast",
    "broadcast",
    "session"
  ],
  "license": "MIT",
  "author": "node-red-contrib-tcpip contributors",
  "engines": {
    "node": ">=20"
  },
  "main": "nodes/connect.js",
  "scripts": {
    "test": "mocha 'test/**/*.test.js' --timeout 5000"
  },
  "devDependencies": {
    "mocha": "^11.7.6",
    "proxyquire": "^2.1.3"
  },
  "node-red": {
    "nodes": {
      "tcp-connect": "nodes/connect.js",
      "tcp-send": "nodes/send.js",
      "tcp-disconnect": "nodes/disconnect.js",
      "udp-in": "nodes/udp-in.js",
      "udp-out": "nodes/udp-out.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/example/node-red-contrib-tcpip.git"
  }
}
